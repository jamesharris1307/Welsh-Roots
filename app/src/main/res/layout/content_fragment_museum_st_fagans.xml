<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:layout_marginBottom="100dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansTitlePageOne"
            android:textStyle="bold"
            android:textColor="?attr/paraText"
            android:textSize="40sp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="75dp" />

        <WebView
            android:id="@+id/stFagansYoutube"
            android:layout_width="0dp"
            android:layout_height="300dp"
            app:layout_constraintTop_toBottomOf="@id/titleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />

        <TextView
            android:id="@+id/exhibitOneTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansTitleExhibitOne"
            android:textStyle="bold"
            android:textColor="?attr/headingText"
            android:textSize="30sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/stFagansYoutube"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />

        <TextView
            android:id="@+id/descriptionExhibitOneText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansExhibitOneParagraph"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/exhibitOneTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>

        <WebView
            android:id="@+id/exhibitOneYoutube"
            android:layout_width="0dp"
            android:layout_height="300dp"
            app:layout_constraintTop_toBottomOf="@id/descriptionExhibitOneText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />

        <TextView
            android:id="@+id/webLinkTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/linkToExhibit"
            android:textColor="?attr/headingText"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/exhibitOneYoutube"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/webLinkExhibitOne"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansLinkToWebsiteExhibitOne"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/webLinkTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>

        <FrameLayout
            android:id="@+id/streetViewContainer"
            android:layout_width="0dp"
            android:layout_height="300dp"
            app:layout_constraintTop_toBottomOf="@id/webLinkExhibitOne"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />

        <TextView
            android:id="@+id/exhibitTwoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansTitleExhibitTwo"
            android:textStyle="bold"
            android:textColor="?attr/headingText"
            android:textSize="30sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/streetViewContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />

        <TextView
            android:id="@+id/descriptionExhibitTwoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansExhibitTwoParagraph"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/exhibitTwoTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>

        <WebView
            android:id="@+id/exhibitTwoYoutube"
            android:layout_width="0dp"
            android:layout_height="300dp"
            app:layout_constraintTop_toBottomOf="@id/descriptionExhibitTwoText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />

        <TextView
            android:id="@+id/webLinkTitleTwo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/linkToExhibit"
            android:textColor="?attr/headingText"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/exhibitTwoYoutube"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/webLinkExhibitTwo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansLinkToWebsiteExhibitTwo"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/webLinkTitleTwo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintTop_toBottomOf="@id/webLinkExhibitTwo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="15dp" />

        <TextView
            android:id="@+id/detailsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansMusuemOneLocation"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/mapContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/byBikeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bikeTitle"
            android:textColor="?attr/headingText"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/detailsText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/byBikeDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansByBikeDesc"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/byBikeTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/byCarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/carTitle"
            android:textColor="?attr/headingText"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/byBikeDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/byCarDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansByCarDesc"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/byCarTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/byBusTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/busTitle"
            android:textColor="?attr/headingText"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/byCarDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/byBusDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansByBusDesc"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/byBusTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/byTrainTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/trainTitle"
            android:textColor="?attr/headingText"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/byBusDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/byTrainDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansByTrainDesc"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/byTrainTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/creditsStFagansTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansCreditsTitle"
            android:textColor="@color/grey"
            android:textSize="20sp"
            android:textStyle="italic"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/byTrainDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>

        <TextView
            android:id="@+id/creditsStFagansDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansCreditsBody"
            android:textColor="@color/grey"
            android:textStyle="italic"
            android:textSize="11sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/creditsStFagansTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
