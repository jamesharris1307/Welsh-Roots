<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:layout_marginBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/appBackground">

        <TextView
            android:id="@+id/homePageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home"
            android:textSize="24sp"
            android:layout_marginTop="100dp"
            android:gravity="center"
            android:textColor="?attr/paraText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home"
            android:textSize="18sp"
            android:textColor="@color/grey" />

        <Button
            android:id="@+id/buttonMuseumStFagans"
            android:layout_width="320dp"
            android:layout_height="150dp"
            android:contentDescription="@string/stFagansTitlePageOne"
            android:layout_marginHorizontal="35dp"
            android:layout_marginVertical="35dp"
            android:text="@string/stFagansTitlePageOne"
            android:backgroundTint="@color/greenLight"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="20sp" />

        <Button
            android:id="@+id/buttonMuseumBigPit"
            android:layout_width="320dp"
            android:layout_height="150dp"
            android:contentDescription="@string/bigPitTitle"
            android:layout_marginHorizontal="35dp"
            android:layout_marginVertical="35dp"
            android:text="@string/bigPitTitle"
            android:backgroundTint="@color/greenLight"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="20sp" />

        <Button
            android:id="@+id/buttonMuseumNationalCardiff"
            android:layout_width="320dp"
            android:layout_height="150dp"
            android:contentDescription="@string/nationalMuseumCardiffTitle"
            android:layout_marginHorizontal="35dp"
            android:layout_marginVertical="35dp"
            android:text="@string/nationalMuseumCardiffTitle"
            android:backgroundTint="@color/greenLight"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="20sp" />

        <Button
            android:id="@+id/buttonMuseumWaterfront"
            android:layout_width="320dp"
            android:layout_height="150dp"
            android:contentDescription="@string/explore"
            android:layout_marginHorizontal="35dp"
            android:layout_marginVertical="35dp"
            android:text="@string/nationalWaterfrontTitle"
            android:backgroundTint="@color/greenLight"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="20sp" />

    </LinearLayout>

</ScrollView>
