<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:layout_marginBottom="100dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--Title of Page-->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bigPitTitle"
            android:textStyle="bold"
            android:textColor="?attr/paraText"
            android:textSize="40sp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="75dp" />

        <!--Description of Page-->
        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="{{ Explain this page }}"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/titleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!--Youtube Container (Video)-->
        <WebView
            android:id="@+id/bigPitYoutube"
            android:layout_width="0dp"
            android:layout_height="300dp"
            app:layout_constraintTop_toBottomOf="@id/descriptionText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />

        <!--Exhibit One () -->
        <TextView
            android:id="@+id/exhibitOneTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bigPitTitleExhibitOne"
            android:textStyle="bold"
            android:textColor="?attr/paraText"
            android:textSize="30sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/bigPitYoutube"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />


        <!--Description of Exhibit One ()-->
        <TextView
            android:id="@+id/descriptionExhibitOneText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bigPitExhibitOneParagraph"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/exhibitOneTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>


        <!--Youtube Container (Exhibit One Video)-->
        <WebView
            android:id="@+id/exhibitOneYoutube"
            android:layout_width="0dp"
            android:layout_height="300dp"
            app:layout_constraintTop_toBottomOf="@id/descriptionExhibitOneText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />

        <!--Web Link Title-->
        <TextView
            android:id="@+id/webLinkTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Link to Exhibit"
            android:textColor="?attr/headingText"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/exhibitOneYoutube"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="10dp"/>

        <!--Web Link for Exhibit One-->
        <TextView
            android:id="@+id/webLinkExhibitOne"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bigPitLinkToWebsiteExhibitOne"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/webLinkTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>

        <!--Street View Container ()-->
        <FrameLayout
            android:id="@+id/streetViewContainer"
            android:layout_width="0dp"
            android:layout_height="300dp"
            app:layout_constraintTop_toBottomOf="@id/webLinkExhibitOne"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />

        <!--Exhibit Two ()-->
        <TextView
            android:id="@+id/exhibitTwoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bigPitTitleExhibitTwo"
            android:textStyle="bold"
            android:textColor="?attr/paraText"
            android:textSize="30sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/streetViewContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp" />

        <!--Description of Exhibit Two ()-->
        <TextView
            android:id="@+id/descriptionExhibitTwoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bigPitExhibitTwoParagraph"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/exhibitTwoTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>

        <!--Web Link Title-->
        <TextView
            android:id="@+id/webLinkTitleTwo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Link to Exhibit"
            android:textColor="?attr/headingText"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/descriptionExhibitTwoText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="10dp"/>

        <!--Web Link for Exhibit Two-->
        <TextView
            android:id="@+id/webLinkExhibitTwo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bigPitLinkToWebsiteExhibitTwo"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/webLinkTitleTwo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>

        <!--Maps View-->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintTop_toBottomOf="@id/webLinkExhibitTwo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="15dp" />

        <!--Location of St.Fagans-->
        <TextView
            android:id="@+id/detailsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bigPitLocation"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/mapContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!--Transport Title (Car)-->
        <TextView
            android:id="@+id/byCarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/carTitle"
            android:textColor="?attr/headingText"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/detailsText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>

        <!--Transport Description (Car)-->
        <TextView
            android:id="@+id/byCarDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bigPitByCarDesc"
            android:justificationMode="inter_word"
            android:textColor="?attr/paraText"
            android:textSize="15sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/byCarTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>

        <!--Credits and References (Title)-->
        <TextView
            android:id="@+id/creditsStFagansTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stFagansCreditsTitle"
            android:textColor="@color/grey"
            android:textSize="20sp"
            android:textStyle="italic"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/byCarDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="10dp"/>

        <!--Credits and References (Description)-->
        <TextView
            android:id="@+id/creditsStFagansDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bigPitCreditsBody"
            android:textColor="@color/grey"
            android:textStyle="italic"
            android:textSize="11sp"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/creditsStFagansTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="10dp"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
