<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground">

    <LinearLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="20dp">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:contentDescription="@string/about"
            app:srcCompat="@drawable/ic_welsh_roots"
            android:layout_marginTop="250dp"/>

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:textColor="@color/white"/>

        <!--Prompt User to leave a review about the app-->
        <TextView
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:text="@string/linkToExhibit"
            android:gravity="center"
            android:layout_marginTop="50dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp" />

        <!--Input field for user reviews-->
        <EditText
            android:id="@+id/reviewInput"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/reviewInput"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            android:padding="12dp"
            android:textSize="16sp"
            android:inputType="textMultiLine"
            android:minHeight="100dp" />

        <!--Button to submit the review-->
        <Button
            android:id="@+id/submitReviewButton"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reviewSubmit"
            android:textColor="@color/white"
            android:layout_marginHorizontal="45dp"
            android:padding="12dp"
            android:backgroundTint="?attr/buttonBackground"
            app:cornerRadius="8dp" />

        <!--Display Reviews-->
        <TextView
            android:id="@+id/reviewDisplay"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="@string/displayReviews"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/rounded_background"
            android:textSize="16sp"
            android:gravity="center_vertical" />
    </LinearLayout>

</ScrollView>