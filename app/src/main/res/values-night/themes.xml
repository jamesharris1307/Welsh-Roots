<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WelshRoots" parent="Theme.Material3.DayNight.NoActionBar">

        <!--Background Colour-->
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/statusBarDark</item>
        <!-- App Background -->
        <item name="appBackground">@color/appBackgroundDark</item>
        <!-- Button -->
        <item name="buttonBackground">@color/buttonBackgroundDark</item>
        <!-- Banner -->
        <item name="bannerBackground">@color/bannerBackgroundDark</item>
        <!-- Nav Bar -->
        <item name="navBarBackground">@color/bannerBackgroundDark</item>

        <!--Text Colour-->
        <!--Button Text-->
        <item name="buttonText">@color/white</item>
        <!--Banner Text-->
        <item name="bannerText">@color/white</item>
        <!--Paragraph Text-->
        <item name="paraText">@color/paraTextDark</item>
        <!--Icon Text-->
        <item name="iconText">@color/iconTextDark</item>
        <!--Heading Text-->
        <item name="headingText">@color/headingTextDark</item>

        <!-- Edge Effect -->
        <item name="android:colorEdgeEffect">@color/greenLight</item>

        <!--Icons-->
        <item name="icons">@color/iconsDark</item>
        <item name="navIconBackground">@color/navIconBackgroundDark</item>

    </style>

    <style name="Theme.WelshRoots" parent="Base.Theme.WelshRoots" />
</resources>